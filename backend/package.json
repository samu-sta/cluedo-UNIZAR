{
  "name": "backend-cluedo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch ./src/index.js",
    "init-db": "node ./src/database/init.js",
    "start": "npm run init-db && npm run dev",
    "test": "cross-env NODE_ENV=test jest --config=jest.config.js",
    "test:unit": "cross-env NODE_ENV=test jest --config=jest.config.js --testPathPattern=test/unit",
    "test:integration": "cross-env NODE_ENV=test jest --config=jest.config.js --testPathPattern=test/integration",
    "test:e2e": "cross-env NODE_ENV=test jest --config=jest.config.js --testPathPattern=test/e2e",
    "test:watch": "cross-env NODE_ENV=test jest --config=jest.config.js --watch",
    "test:debug": "cross-env NODE_ENV=test DEBUG_TESTS=true jest --config=jest.config.js --detectOpenHandles --verbose"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "npm@10.8.3",
  "dependencies": {
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "http": "^0.0.1-security",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "mysql2": "3.12.0",
    "sequelize": "6.37.5",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.27.1",
    "@babel/preset-env": "^7.27.1",
    "@babel/runtime": "^7.27.1",
    "babel-jest": "^29.7.0",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.0"
  }
}
