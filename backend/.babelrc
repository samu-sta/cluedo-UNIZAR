{
  "presets": [
    ["@babel/preset-env", {
      "targets": {
        "node": "current"
      }
    }]
  ],
  "plugins": [
    "@babel/plugin-transform-modules-commonjs",
    ["module-resolver", {
      "root": ["./src"],
      "alias": {
        "@": "./src",
        "@test": "./test"
      }
    }]
  ]
}